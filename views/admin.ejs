<%- include('partials/header',{title:'Administración'}) %><main class="shell page"><div class="page-head"><div><h1>Certificados</h1><div class="help">Gestión centralizada en Supabase y Google Drive.</div></div><div><a class="btn btn-light" href="/admin/importar">Importar CSV</a> <a class="btn" href="/admin/nuevo">Nuevo certificado</a></div></div><% if(message){ %><div class="notice"><%= message %></div><% } %><section class="grid"><div class="card stat"><span>Total</span><strong><%= stats.total||0 %></strong></div><div class="card stat"><span>Válidos</span><strong><%= stats.validos||0 %></strong></div><div class="card stat"><span>Anulados</span><strong><%= stats.anulados||0 %></strong></div></section><section class="card"><form class="search" action="/admin"><input name="q" value="<%= q %>" placeholder="Buscar por código o nombre"><button class="btn btn-light">Buscar</button></form><br><div class="table-wrap"><table class="table"><thead><tr><th>Código</th><th>Participante</th><th>Curso</th><th>Fecha</th><th>Estado</th><th>Acciones</th></tr></thead><tbody><% certs.forEach(c=>{ %><tr><td><%= c.code %></td><td><%= c.full_name %></td><td><%= c.courses?.title||'' %></td><td><%= c.issue_date %></td><td><span class="badge <%= c.status==='VALIDO'?'valid':'invalid' %>"><%= c.status %></span></td><td class="actions"><a class="btn btn-light btn-sm" target="_blank" href="/verificar/<%= encodeURIComponent(c.code) %>">Validar</a><a class="btn btn-light btn-sm" href="/admin/<%= c.id %>/editar">Editar</a><% if(c.drive_file_id){ %><a class="btn btn-light btn-sm" target="_blank" href="/certificados/<%= encodeURIComponent(c.code) %>/pdf">PDF</a><% } %><form method="post" action="/admin/<%= c.id %>/estado"><input type="hidden" name="status" value="<%= c.status==='VALIDO'?'ANULADO':'VALIDO' %>"><button class="btn btn-red btn-sm"><%= c.status==='VALIDO'?'Anular':'Reactivar' %></button></form></td></tr><% }) %><% if(!certs.length){ %><tr><td colspan="6">No hay certificados registrados.</td></tr><% } %></tbody></table></div></section></main><%- include('partials/footer') %>
