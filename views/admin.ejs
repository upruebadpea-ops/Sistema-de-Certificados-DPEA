<%- include('partials/header',{title:'Administración'}) %><main class="shell page"><div class="page-head"><div><h1>Certificados por curso</h1><div class="help">Cada bloque corresponde a una carpeta de Google Drive.</div></div><div><a class="btn btn-light" href="/admin/plantillas">Plantillas</a> <a class="btn btn-light" href="/admin/importar">Importar CSV</a> <a class="btn" href="/admin/nuevo">Nuevo certificado</a></div></div><% if(message){ %><div class="notice"><%= message %></div><% } %><section class="grid"><div class="card stat"><span>Total</span><strong><%= stats.total||0 %></strong></div><div class="card stat"><span>Válidos</span><strong><%= stats.validos||0 %></strong></div><div class="card stat"><span>Anulados</span><strong><%= stats.anulados||0 %></strong></div></section><section class="card search-card"><form class="search" action="/admin"><input name="q" value="<%= q %>" placeholder="Buscar por código o nombre"><button class="btn btn-light">Buscar</button></form></section><section class="course-grid"><% groups.forEach(g=>{ %><article class="card course-card"><div class="course-card-head"><div><span class="folder-icon">▰</span><h2><%= g.title %></h2><div class="help"><%= g.certs.length %> certificado<%= g.certs.length===1?'':'s' %></div></div><% if(g.folderId){ %><span class="badge valid">Drive listo</span><% } %></div><div class="certificate-list"><% g.certs.forEach(c=>{ %><div class="certificate-item"><div><strong><%= c.full_name %></strong><small><%= c.code %> · <%= c.issue_date %></small></div><div class="mini-actions"><span class="badge <%= c.status==='VALIDO'?'valid':'invalid' %>"><%= c.status %></span><a href="/admin/<%= c.id %>/editar">Editar</a><% if(c.drive_file_id){ %><a target="_blank" href="/certificados/<%= encodeURIComponent(c.code) %>/pdf">PDF</a><% } %></div></div><% }) %></div></article><% }) %><% if(!groups.length){ %><article class="card empty-state"><h2>Aún no hay certificados</h2><p>Cree el primero para que aparezca organizado dentro de su curso.</p><a class="btn" href="/admin/nuevo">Crear certificado</a></article><% } %></section></main><%- include('partials/footer') %>


