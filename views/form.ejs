<%- include('partials/header',{title:cert?'Editar certificado':'Nuevo certificado'}) %><main class="shell page"><div class="page-head"><h1><%= cert?'Editar certificado':'Nuevo certificado' %></h1><a href="/admin">← Volver</a></div><section class="card form"><% if(error){ %><div class="error"><%= error %></div><% } %><form method="post"><div class="fields"><div class="field"><label>Código</label><input name="codigo" value="<%= cert?.code||'' %>" placeholder="Se genera automáticamente"><div class="help">Déjelo vacío para generar uno seguro.</div></div><div class="field"><label>Nombre completo *</label><input name="nombre" required value="<%= cert?.full_name||'' %>"></div><div class="field"><label>CI / Documento</label><input name="ci" value="<%= cert?.document_id||'' %>"></div><div class="field"><label>Fecha de emisión *</label><input type="date" name="fecha" required value="<%= cert?.issue_date||new Date().toISOString().slice(0,10) %>"></div><div class="field full"><label>Evento o curso *</label><input name="evento" required value="<%= cert?.event_name||'' %>"></div><div class="field"><label>Carga horaria</label><input name="horas" value="<%= cert?.hours||'' %>" placeholder="Ej.: 40 horas académicas"></div><% if(cert){ %><div class="field"><label>Estado</label><select name="status"><option value="VALIDO" <%= cert.status==='VALIDO'?'selected':'' %>>Válido</option><option value="ANULADO" <%= cert.status==='ANULADO'?'selected':'' %>>Anulado</option></select></div><% } %><div class="field full"><button class="btn"><%= cert?'Guardar y regenerar PDF':'Crear certificado y PDF' %></button></div></div></form></section></main><%- include('partials/footer') %>
