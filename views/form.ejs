<%- include('partials/header',{title:cert?'Editar certificado':'Nuevo certificado'}) %>
<main class="shell page"><div class="page-head"><h1><%= cert?'Editar certificado':'Nuevo certificado' %></h1><a href="/admin">← Volver</a></div><section class="card form"><% if(error){ %><div class="error"><%= error %></div><% } %><form method="post" enctype="multipart/form-data"><div class="fields">
<div class="field"><label>Nombre completo *</label><input name="nombre" required value="<%= cert?.full_name||'' %>"></div><div class="field"><label>C.I.</label><input name="ci" value="<%= cert?.document_id||'' %>"></div><div class="field"><label>Fecha</label><input type="date" name="fecha" value="<%= cert?.issue_date||new Date().toISOString().slice(0,10) %>"></div>
<div class="field full"><label>Curso *</label><select id="course-select"><option value="">Seleccione un curso o carpeta…</option><% courses.forEach(c=>{ %><option value="<%= c.id %>" data-title="<%= c.title %>" data-description="<%= c.description||'' %>" data-folder="<%= c.drive_folder_id||'' %>" data-template-id="<%= c.template_file_id||'' %>" data-template-name="<%= c.template_name||'' %>" data-end-date="<%= c.end_date||'' %>" data-signatures="<%= JSON.stringify(c.signatures||[]) %>" <%= (cert?.courses?.id===c.id)?'selected':'' %>><%= c.title %><%= c.drive_folder_id?' · carpeta creada':'' %></option><% }) %><option value="__new__">＋ Escribir un curso nuevo</option></select><input id="course-title" name="curso" required value="<%= cert?.courses?.title||cert?.course_title||'' %>" placeholder="Nombre del curso" style="margin-top:8px"><div id="folder-help" class="help">Al crear el primer certificado se crea su carpeta en Drive.</div></div>
<div class="field full"><label>Descripción del curso</label><textarea id="course-description" name="descripcion" rows="4" placeholder="Se reutiliza para todos los certificados del curso."><%= cert?.courses?.description||cert?.course_description||'' %></textarea><div class="help">Al seleccionar un curso existente, esta descripción se completa automáticamente.</div></div>
<div class="field full"><label>Plantilla de fondo</label><select id="template-select" name="template_file_id"><option value="">Diseño predeterminado</option><% templates.forEach(t=>{ %><option value="<%= t.id %>" data-name="<%= t.name %>" <%= ((cert?.courses?.template_file_id||cert?.template_file_id)===t.id)?'selected':'' %>><%= t.name %></option><% }) %></select><input type="hidden" id="template-name" name="template_name" value="<%= cert?.courses?.template_name||cert?.template_name||'' %>"><div class="help">Puede añadir fondos PNG/JPG desde <a href="/admin/plantillas">Plantillas</a>.</div></div>
<div class="field"><label>Carga horaria</label><input name="horas" value="<%= cert?.hours||'' %>" placeholder="Ej.: 40 horas académicas"></div><div class="field"><label>Fecha de finalización del curso</label><input id="end-date" type="date" name="fecha_fin" value="<%= cert?.courses?.end_date||cert?.end_date||'' %>"><div class="help">Se guardará para todos los participantes de este curso.</div></div>
<div class="field full"><h2 class="section-title">Firmas del curso</h2><p class="help">Opcionales. Se guardan con este curso y se recuperan automáticamente al volver a seleccionarlo.</p><div class="signature-grid"><% for(let i=1;i<=5;i++){const item=(cert?.courses?.signatures||cert?.signatures||[])[i-1]||{};%><fieldset class="signature-field" data-signature-index="<%= i %>"><legend>Firma <%= i %></legend><div class="field"><label>Firma PNG</label><input type="file" name="firma_<%= i %>" accept="image/png"><div class="help signature-status"><%= item.file_id?'Firma guardada. Cargue otra solo para reemplazarla.':'Opcional' %></div><% if(item.file_id){ %><label class="help"><input type="checkbox" name="eliminar_firma_<%= i %>" value="1"> Eliminar imagen de firma</label><% } %></div><div class="field"><label>Nombre</label><input class="signature-name" name="nombre_firma_<%= i %>" value="<%= item.name||'' %>"></div><div class="field"><label>Cargo</label><input class="signature-role" name="cargo_firma_<%= i %>" value="<%= item.role||'' %>"></div><div class="field"><label>Institución</label><input class="signature-institution" name="institucion_firma_<%= i %>" value="<%= item.institution||'' %>"></div></fieldset><% } %></div></div>
<% if(cert){ %><div class="field"><label>Estado</label><select name="status"><option value="VALIDO" <%= cert.status==='VALIDO'?'selected':'' %>>Válido</option><option value="ANULADO" <%= cert.status==='ANULADO'?'selected':'' %>>Anulado</option></select></div><% } %><div class="field full"><button class="btn"><%= cert?'Guardar cambios y actualizar PDF':'Crear certificado y subir a Drive' %></button></div>
</div></form></section></main><div id="creating-overlay" class="creating-overlay" aria-live="polite" aria-hidden="true"><div class="creating-dialog"><div class="creating-spinner"></div><strong>Creando certificado…</strong><span>Generando PDF, subiendo a Drive y registrando en Google Sheets.</span></div></div>
<script>const form=document.querySelector('form'),courseSelect=document.querySelector('#course-select'),title=document.querySelector('#course-title'),description=document.querySelector('#course-description'),folderHelp=document.querySelector('#folder-help'),templateSelect=document.querySelector('#template-select'),templateName=document.querySelector('#template-name'),endDate=document.querySelector('#end-date'),overlay=document.querySelector('#creating-overlay');function fillSignatures(list=[]){document.querySelectorAll('[data-signature-index]').forEach(box=>{const s=list[Number(box.dataset.signatureIndex)-1]||{};box.querySelector('.signature-name').value=s.name||'';box.querySelector('.signature-role').value=s.role||'';box.querySelector('.signature-institution').value=s.institution||'';box.querySelector('.signature-status').textContent=s.file_id?'Firma guardada. Cargue otra solo para reemplazarla.':'Opcional'})}function applyCourse(){const o=courseSelect.selectedOptions[0];if(!o||!courseSelect.value)return;if(courseSelect.value==='__new__'){title.value='';description.value='';templateSelect.value='';templateName.value='';endDate.value='';fillSignatures();folderHelp.textContent='Se creará una carpeta nueva en Drive con este nombre.';title.focus();return}title.value=o.dataset.title||'';description.value=o.dataset.description||'';templateSelect.value=o.dataset.templateId||'';templateName.value=o.dataset.templateName||'';endDate.value=o.dataset.endDate||'';try{fillSignatures(JSON.parse(o.dataset.signatures||'[]'))}catch(_e){fillSignatures()}folderHelp.textContent=o.dataset.folder?'Carpeta de Drive vinculada y lista.':'La carpeta se creará al emitir el primer certificado.'}courseSelect.addEventListener('change',applyCourse);templateSelect.addEventListener('change',()=>templateName.value=templateSelect.selectedOptions[0]?.dataset.name||'');form.addEventListener('submit',()=>{if(!form.checkValidity())return;overlay.classList.add('visible');overlay.setAttribute('aria-hidden','false');form.querySelector('button[type="submit"],button:not([type])').disabled=true});</script>
<%- include('partials/footer') %>
