<%- include('partials/header',{title:cert?'Editar certificado':'Nuevo certificado'}) %>
<main class="shell page"><div class="page-head"><h1><%= cert?'Editar certificado':'Nuevo certificado' %></h1><a href="/admin">← Volver</a></div><section class="card form"><% if(error){ %><div class="error"><%= error %></div><% } %><form method="post"><div class="fields">
<div class="field"><label>Código</label><input name="codigo" value="<%= cert?.code||'' %>" placeholder="Se genera automáticamente"><div class="help">No se imprime en el PDF.</div></div><div class="field"><label>Nombre completo *</label><input name="nombre" required value="<%= cert?.full_name||'' %>"></div>
<div class="field"><label>CI / Documento</label><input name="ci" value="<%= cert?.document_id||'' %>"></div><div class="field"><label>Fecha de emisión *</label><input type="date" name="fecha" required value="<%= cert?.issue_date||new Date().toISOString().slice(0,10) %>"></div>
<div class="field full"><label>Curso *</label><input name="curso" list="lista-cursos" required value="<%= cert?.courses?.title||cert?.course_title||'' %>" placeholder="Seleccione o escriba un curso nuevo"><datalist id="lista-cursos"><% courses.forEach(c=>{ %><option value="<%= c.title %>"></option><% }) %></datalist><div class="help">Seleccione uno existente o escriba uno nuevo.</div></div>
<div class="field full"><label>Descripción del curso</label><textarea name="descripcion" rows="4" placeholder="Se reutiliza para todos los certificados del curso."><%= cert?.courses?.description||cert?.course_description||'' %></textarea></div><div class="field"><label>Carga horaria</label><input name="horas" value="<%= cert?.hours||'' %>" placeholder="Ej.: 40 horas académicas"></div>
<% if(cert){ %><div class="field"><label>Estado</label><select name="status"><option value="VALIDO" <%= cert.status==='VALIDO'?'selected':'' %>>Válido</option><option value="ANULADO" <%= cert.status==='ANULADO'?'selected':'' %>>Anulado</option></select></div><% } %><div class="field full"><button class="btn"><%= cert?'Guardar y reemplazar PDF en Drive':'Crear PDF y guardar en Drive' %></button></div>
</div></form></section></main><%- include('partials/footer') %>
