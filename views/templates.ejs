<%- include('partials/header',{title:'Plantillas de certificados'}) %><main class="shell page"><div class="page-head"><div><h1>Plantillas de fondo</h1><div class="help">Fondos reutilizables guardados en Google Drive.</div></div><a href="/admin">← Volver</a></div><% if(message){ %><div class="notice"><%= message %></div><% } %><% if(error){ %><div class="error"><%= error %></div><% } %><section class="card form"><h2>Subir una plantilla</h2><p class="help">Use PNG o JPG horizontal, idealmente 842 × 595 px. El texto y el QR se colocarán encima.</p><form method="post" enctype="multipart/form-data"><div class="field"><label>Imagen de fondo</label><input type="file" name="plantilla" accept="image/png,image/jpeg" required></div><br><button class="btn">Guardar en Drive</button></form><% if(folderId){ %><p class="help">Carpeta creada: <a target="_blank" href="https://drive.google.com/drive/folders/<%= folderId %>">abrir _PLANTILLAS en Drive</a></p><% } %></section><section class="template-grid"><% templates.forEach(t=>{ %><div class="card template-card"><strong><%= t.name %></strong><span class="help"><%= t.mimeType %></span><% if(t.webViewLink){ %><a target="_blank" href="<%= t.webViewLink %>">Abrir en Drive</a><% } %></div><% }) %><% if(!templates.length&&!error){ %><div class="card">Todavía no hay plantillas.</div><% } %></section></main><%- include('partials/footer') %>
