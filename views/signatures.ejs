<%- include('partials/header',{title:'Firmas de certificados'}) %>
<main class="shell page"><div class="page-head"><div><h1>Firmas del certificado</h1><div class="help">Puede usar entre una y cinco firmas. Todos los campos son opcionales.</div></div><a href="/admin">← Volver</a></div><% if(message){ %><div class="notice"><%= message %></div><% } %><% if(error){ %><div class="error"><%= error %></div><% } %><section class="card"><form method="post" enctype="multipart/form-data"><div class="signature-grid"><% for(let i=1;i<=5;i++){ const item=signatures[i-1]||{}; %><fieldset class="signature-field"><legend>Firma <%= i %></legend><div class="field"><label>Imagen de firma PNG</label><input type="file" name="firma_<%= i %>" accept="image/png"><div class="help"><%= item.file_id?'Ya hay una firma guardada. Cargue otra solo si desea reemplazarla.':'Opcional' %></div></div><div class="field"><label>Nombre</label><input name="nombre_<%= i %>" value="<%= item.name||'' %>"></div><div class="field"><label>Cargo</label><input name="cargo_<%= i %>" value="<%= item.role||'' %>"></div><div class="field"><label>Institución</label><input name="institucion_<%= i %>" value="<%= item.institution||'' %>"></div></fieldset><% } %></div><br><button class="btn">Guardar firmas</button></form><% if(folderId){ %><p class="help">Las imágenes PNG se guardan en <a target="_blank" href="https://drive.google.com/drive/folders/<%= folderId %>">_FIRMAS de Google Drive</a>.</p><% } %></section></main>
<%- include('partials/footer') %>
