<%- include('partials/header',{title:'Resultado de validación'}) %><main class="shell"><section class="card verify-card"><div class="verify-header"><h1>Verificación oficial</h1><p><%= institution %></p></div><% if(!cert){ %><div class="verify-status"><span class="badge invalid">CERTIFICADO NO ENCONTRADO</span><p>El código consultado no existe.</p></div><% } else if(cert.status!=='VALIDO'){ %><div class="verify-status"><span class="badge invalid">CERTIFICADO ANULADO</span><p>Este documento no se encuentra vigente.</p></div><% } else { %><div class="verify-status"><span class="badge valid">✓ CERTIFICADO VÁLIDO Y AUTÉNTICO</span></div><div class="details"><div class="row"><b>Código</b><span><%= cert.code %></span></div><div class="row"><b>Titular</b><span><%= cert.full_name %></span></div><div class="row"><b>Documento</b><span><%= cert.document_id?'*'.repeat(Math.max(0,cert.document_id.length-4))+cert.document_id.slice(-4):'No publicado' %></span></div><div class="row"><b>Curso</b><span><%= cert.courses?.title||'' %></span></div><% if(cert.courses?.description){ %><div class="row"><b>Descripción</b><span><%= cert.courses.description %></span></div><% } %><div class="row"><b>Carga horaria</b><span><%= cert.hours||'No especificada' %></span></div><div class="row"><b>Fecha de emisión</b><span><%= cert.issue_date %></span></div></div><% if(cert.drive_file_id){ %><p style="text-align:center"><a class="btn" target="_blank" href="/certificados/<%= encodeURIComponent(cert.code) %>/pdf">Descargar certificado PDF</a></p><% } %><% } %></section></main><%- include('partials/footer') %>
